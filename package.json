{
  "name": "agent-address",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "db:create": "wrangler d1 create agent-address",
    "db:migrate:local": "wrangler d1 migrations apply agent-address --local",
    "db:migrate:remote": "wrangler d1 migrations apply agent-address --remote",
    "check": "tsc --noEmit",
    "style:check": "node scripts/check-code-principles.mjs",
    "test": "vitest run && node --test scripts/audit-report.checks.mjs",
    "audit:report": "node scripts/audit-report.mjs",
    "audit:check": "node scripts/audit-report.mjs --enforce"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.38.0",
    "@cloudflare/vitest-plugin": "^1.4.7"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "agents": "^0.32.0",
    "zod": "^4.6.5",
    "jose": "^6.2.12"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  }
}
